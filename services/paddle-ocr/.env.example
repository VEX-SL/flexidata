# FlexiData PaddleOCR sidecar — configuration (all values are optional).

# Bind address / port for the uvicorn start command.
PADDLE_OCR_HOST=0.0.0.0
PADDLE_OCR_PORT=8000

# Hard cap on the raw JSON request body (bytes). 25 MB default.
PADDLE_OCR_MAX_PAYLOAD_BYTES=25000000

# Max decoded image side (pixels). Larger images are rejected with HTTP 400.
PADDLE_OCR_MAX_IMAGE_DIM=8192

# Inference deadline (ms); exceeded inference returns HTTP 504.
PADDLE_OCR_INFERENCE_TIMEOUT_MS=20000

# Log level: INFO / DEBUG / WARNING.
PADDLE_OCR_LOG_LEVEL=INFO

# Comma-separated origins allowed to call this service.
# Empty = no CORS headers are emitted at all (recommended for a server-side
# sidecar; the FlexiData Node client is not a browser and needs no CORS).
PADDLE_OCR_ALLOWED_ORIGINS=