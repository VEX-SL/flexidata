+      .catch((error) => sendResponse({ ok: false, requestId: message.requestId, error: error instanceof Error ? error.message : "Browser context unavailable." }));
+    return true;
+  }
+  if (message?.type === "APP_EXECUTE_BROWSER_ACTION") {
+    void executeBrowserActionForApp(message, sender)
+      .then((result) => sendResponse({ ok: true, requestId: message.requestId, result }))
+      .catch((error) => sendResponse({ ok: false, requestId: message.requestId, error: error instanceof Error ? error.message : "Browser action failed." }));
+    return true;
+  }
+  if (message?.type === "PAGE_STATE_CHANGED") {
+    const tabId = sender.tab?.id;
+    const watch = typeof tabId === "number" ? pageWatches.get(tabId) : undefined;
+    let sameOrigin = false;
+    try {
+      sameOrigin = new URL(watch?.url || "").origin === new URL(message.url).origin;
+    } catch {
+      sameOrigin = false;
+    }
+    if (
+      sender.id !== chrome.runtime.id || !watch || watch.watchId !== message.watchId ||
+      !sameOrigin || typeof tabId !== "number"
+    ) {
+      sendResponse({ ok: false });
+      return false;
+    }
+    watch.url = message.url;
+    void chrome.scripting.executeScript({ target: { tabId }, func: inspectPage })
+      .then(async (results) => {
+        const observation = results[0]?.result;
+        if (!observation || observation.url !== message.url) return;
+        await chrome.storage.session.set({
+          flexidataLastBrowserObservation: {
+            tabId,
+            url: observation.url,
+            title: observation.title,
+            capturedAt: observation.capturedAt,
+            viewport: observation.viewport,
+            text: observation.text.slice(0, 6000),
+            elements: observation.elements.slice(0, 50),
+            focusedElement: observation.focusedElement
+          }
+        });
+        void chrome.runtime.sendMessage({ type: "BROWSER_PAGE_DIRTY", tabId, url: message.url }).catch(() => {});
+        sendResponse({ ok: true });
+      })
+      .catch(() => sendResponse({ ok: false }));
+    return true;
+  }
+  if (message?.type === "POINT_SELECTED") {
+    void acceptPickedPoint(message, sender)
+      .then((result) => sendResponse({ ok: true, result }))
+      .catch((error) => sendResponse({ ok: false, error: error instanceof Error ? error.message : "Could not select point." }));
+    return true;
+  }
+  void handleMessage(message, sender)
+    .then((result) => sendResponse({ ok: true, result }))
+    .catch((error) => sendResponse({ ok: false, error: error instanceof Error ? error.message : "Request failed." }));
+  return true;
+});
diff --git a/browser-extension/sidepanel.css b/browser-extension/sidepanel.css
new file mode 100644
index 0000000..2607603
--- /dev/null
+++ b/browser-extension/sidepanel.css
@@ -0,0 +1,45 @@
+* { box-sizing: border-box; }
+:root { color-scheme: dark; font-family: Inter, ui-sans-serif, system-ui, sans-serif; background: #0d1117; color: #e6edf3; }
+body { margin: 0; padding: 18px; min-width: 290px; }
+header { margin-bottom: 16px; }
+.eyebrow { color: #74c0fc; letter-spacing: .13em; font-size: 10px; font-weight: 800; }
+h1 { font-size: 23px; margin: 5px 0; }
+h2 { font-size: 14px; margin: 0 0 12px; }
+p { margin: 5px 0; line-height: 1.55; }
+header p, .muted, .hint, footer { color: #9da7b3; font-size: 12px; }
+.card, .notice { border: 1px solid #293341; border-radius: 12px; padding: 13px; margin: 12px 0; background: #141a22; }
+.notice { background: #172331; border-color: #294969; font-size: 12px; line-height: 1.55; }
+.row { display: flex; align-items: center; gap: 8px; }
+.between { justify-content: space-between; }
+.icon-button { width: 32px; padding: 4px; font-size: 20px; }
+button { border: 1px solid #39485a; border-radius: 8px; background: #1b2430; color: #e6edf3; padding: 9px 10px; cursor: pointer; font: inherit; }
+button:hover:not(:disabled) { filter: brightness(1.16); }
+button:disabled { opacity: .45; cursor: not-allowed; }
+.primary { width: 100%; margin-top: 12px; background: #1267b2; border-color: #318ce7; font-weight: 700; }
+.secondary { width: 100%; margin-top: 8px; background: #203329; border-color: #397752; color: #b6f0c9; font-size: 12px; }
+.danger { width: 100%; margin-top: 12px; background: #612a2a; border-color: #a34141; font-size: 12px; }
+.coordinates { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
+label { display: flex; align-items: center; gap: 8px; color: #aeb8c4; font-size: 12px; }
+input { width: 100%; min-width: 0; border: 1px solid #39485a; border-radius: 7px; background: #0d1117; color: white; padding: 8px; }
+.elements { display: grid; gap: 7px; max-height: 340px; overflow: auto; }
+.element { width: 100%; text-align: right; padding: 9px; background: #10161e; }
+.element strong { display: block; font-size: 12px; overflow-wrap: anywhere; }
+.element small { display: block; color: #95a1af; margin-top: 4px; }
+.badge { border-radius: 99px; background: #243142; padding: 3px 8px; color: #b8d6f3; font-size: 11px; }
+.list-heading { margin-top: 18px; }
+.hint { font-size: 11px; }
+.page-text { white-space: pre-wrap; overflow-wrap: anywhere; max-height: 240px; overflow: auto; font-size: 11px; color: #c6d0dc; }
+.visual-heading { display: flex; align-items: baseline; justify-content: space-between; margin-top: 16px; }
+.visual-heading h2 { margin-bottom: 7px; }
+.visual-stage { position: relative; width: 100%; overflow: hidden; border: 1px solid #39485a; border-radius: 8px; background: #070a0e; }
+.visual-stage img { display: block; width: 100%; height: auto; }
+.visual-markers { position: absolute; inset: 0; pointer-events: none; }
+.visual-marker { position: absolute; pointer-events: auto; transform: translate(-50%, -50%); border: 1px solid white; border-radius: 999px; width: 23px; height: 23px; padding: 0; display: grid; place-items: center; background: #1476d4; color: white; box-shadow: 0 1px 5px #000b; font-size: 10px; font-weight: 800; }
+.visual-marker.disabled-marker { background: #66717e; }
+.visual-empty { color: #9da7b3; font-size: 11px; padding: 14px; text-align: center; }
+summary { cursor: pointer; font-size: 12px; margin: 10px 0; }
+.result { margin-top: 10px; padding: 9px; border-radius: 8px; background: #10291f; color: #9ce5ba; font-size: 12px; overflow-wrap: anywhere; }
+.error { background: #351b1b; color: #ffb4ab; }
+code { background: #0d1117; border: 1px solid #293341; border-radius: 4px; padding: 1px 4px; font-size: 11px; }
+.hidden { display: none !important; }
+footer { border-top: 1px solid #27313d; padding-top: 12px; margin-top: 17px; line-height: 1.55; }
diff --git a/browser-extension/sidepanel.html b/browser-extension/sidepanel.html
new file mode 100644
index 0000000..b32476f
--- /dev/null
+++ b/browser-extension/sidepanel.html
@@ -0,0 +1,97 @@
+<!doctype html>
+<html lang="ar" dir="rtl">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>FlexiData Browser Agent</title>
+  <link rel="stylesheet" href="sidepanel.css">
+</head>
+<body>
+  <header>
+    <div class="eyebrow">FLEXIDATA · FOUNDATION</div>
+    <h1>Browser Agent</h1>
+    <p>فحص محلي للصفحة والتفاعل بإذنك فقط.</p>
+  </header>
+
+  <div class="notice"><strong>خصوصية:</strong> الفحص والصورة محليان افتراضياً. لا ينتقل ملخص النص والعناصر إلى AI إلا إذا فعّلت سياق المتصفح في دردشة FlexiData. صلاحية الموقع اختيارية وتغطي hostname نفسه.</div>
+
+  <section class="card">
+    <div class="row between"><h2>التبويب الحالي</h2><button id="refreshTab" class="icon-button" title="تحديث التبويب">↻</button></div>
+    <div id="tabInfo" class="muted">اضغط زر FlexiData في شريط Chrome على الصفحة المطلوبة؛ التفويض يتم في نقرة الزر نفسها.</div>
+    <button id="inspect" class="primary" disabled>افهم الصفحة</button>
+    <button id="grantSite" class="secondary hidden" disabled>السماح لهذا الموقع في تبويباته الأخرى</button>
+    <div id="permissionStatus" class="hint"></div>
+  </section>
+
+  <section id="observation" class="card hidden">
+    <h2>ملخص الصفحة</h2>
+    <div id="pageSummary" class="muted"></div>
+    <div class="visual-heading"><h2>المشهد المرئي</h2><span class="hint">اضغط أي نقطة في الصورة، حتى بلا رقم</span></div>
+    <div id="visualStage" class="visual-stage">
+      <img id="pageScreenshot" alt="لقطة محلية للجزء الظاهر من الصفحة">
+      <div id="visualFallback" class="visual-empty hidden">لقطة اللوحة غير متاحة لهذا التبويب؛ أُضيفت حدود وأرقام مباشرة فوق عناصر الصفحة في التبويب نفسه.</div>
+      <div id="visualMarkers" class="visual-markers"></div>
+    </div>
+    <button id="hideMarkers" class="secondary">إخفاء العلامات من الصفحة</button>
+    <details>
+      <summary>النص الظاهر (حتى ٨٠٠٠ حرف)</summary>
+      <pre id="pageText" class="page-text"></pre>
+    </details>
+    <div class="row between list-heading"><h2>العناصر التفاعلية</h2><span id="elementCount" class="badge"></span></div>
+    <p class="hint">اضغط على رقم فوق لقطة الصفحة أو على عنصر لإدخال مركزه في حقول الإحداثيات.</p>
+    <div id="elements" class="elements"></div>
+    <p id="truncated" class="hint hidden">تم عرض أول ١٢٠ عنصراً ظاهراً فقط.</p>
+  </section>
+
+  <section class="card">
+    <h2>الوضع الموثوق (Trusted Input)</h2>
+    <p class="hint">
+      بعض المواقع تتجاهل النقرات الاصطناعية (<code>isTrusted=false</code>)، خصوصاً أزرار الدفع أو الترقية. الوضع الموثوق
+      يرسل الأحداث عبر Chrome نفسه (CDP) فتصبح <code>isTrusted=true</code>. تفعيله يُظهر شريط تحذير من Chrome فوق النافذة
+      يقول إن هذا التبويب قيد "debugging"، ويبقى ظاهراً طوال الاتصال — هذا سلوك Chrome ولا يمكن إخفاؤه. يمنح أيضاً وصولاً
+      أعمق من إضافة عادية (بروتوكول DevTools كاملاً)، رغم أن هذه الإضافة تستخدم فقط أوامر النقر/التحويم/الكتابة/السحب.
+      فعّله فقط عند الحاجة، وأوقفه بعدها.
+    </p>
+    <div class="row">
+      <button id="trustedAttach" class="secondary" disabled>تفعيل الوضع الموثوق لهذا التبويب</button>
+      <button id="trustedDetach" class="secondary hidden">إيقاف الوضع الموثوق</button>
+    </div>
+    <div id="trustedStatus" class="hint"></div>
+
+    <div id="trustedActions" class="hidden">
+      <p class="hint">تُستخدم نفس إحداثيات X/Y المختارة أدناه للنقر والتحويم والتمرير. للسحب، اختر نقطة البداية ثم أدخل نقطة النهاية.</p>
+      <div class="row">
+        <button id="trustedHover" class="secondary" disabled>تحويم حقيقي عند X/Y</button>
+        <button id="trustedClick" class="danger" disabled>نقر موثوق عند X/Y</button>
+      </div>
+      <label>نص للكتابة الحقيقية <input id="typeText" type="text" placeholder="اكتب هنا نصاً ليُرسل كضغطات مفاتيح فعلية"></label>
+      <button id="trustedType" class="secondary" disabled>إرسال الكتابة الموثوقة</button>
+      <div class="coordinates">
+        <label>X النهاية <input id="dragToX" type="number" min="0" step="1" inputmode="numeric" placeholder="0"></label>
+        <label>Y النهاية <input id="dragToY" type="number" min="0" step="1" inputmode="numeric" placeholder="0"></label>
+      </div>
+      <button id="trustedDrag" class="secondary" disabled>سحب موثوق من X/Y الحالية إلى X/Y النهاية</button>
+      <label>مقدار التمرير (موجب لأسفل، سالب لأعلى)
+        <input id="scrollDeltaY" type="number" min="-2000" max="2000" step="100" value="600">
+      </label>
+      <button id="trustedScroll" class="secondary" disabled>تمرير موثوق عند X/Y الحالية</button>
+    </div>
+    <div id="trustedResult" class="result hidden"></div>
+  </section>
+
+  <section class="card">
+    <h2>النقر على إحداثيات</h2>
+    <p class="hint">اكتب أي إحداثية في مساحة الصفحة، حتى لو لم تكن عليها علامة. الإحداثيات CSS من أعلى اليسار؛ الصورة تمثل الجزء الظاهر فقط. بعد أول فحص يتحدث المشهد تلقائياً بعد النقر/الكتابة/التمرير وتغيّر الصفحة.</p>
+    <div class="coordinates">
+      <label>X <input id="x" type="number" min="0" step="1" inputmode="numeric" placeholder="0"></label>
+      <label>Y <input id="y" type="number" min="0" step="1" inputmode="numeric" placeholder="0"></label>
+    </div>
+    <button id="pickPoint" class="secondary" disabled>اختيار نقطة من الصفحة</button>
+    <button id="clickAt" class="danger" disabled>تحقق من الهدف ثم اطلب تأكيداً</button>
+    <div id="clickResult" class="result hidden"></div>
+  </section>
+
+  <footer>لا يتم قراءة قيم الحقول أو كلمات المرور. لا تدعم هذه المرحلة browser chrome أو نوافذ النظام أو CAPTCHA.</footer>
+  <script src="sidepanel.js"></script>
+</body>
+</html>
diff --git a/browser-extension/sidepanel.js b/browser-extension/sidepanel.js
new file mode 100644
index 0000000..803b386
--- /dev/null
+++ b/browser-extension/sidepanel.js
@@ -0,0 +1,458 @@
+const byId = (id) => document.getElementById(id);
+let activeTab = null;
+let latestObservation = null;
+let trustedAttached = false;
+let autoInspectTimer = 0;
+let autoInspectBusy = false;
+let autoInspectPending = false;
+
+function showTrustedResult(text, isError = false) {
+  const box = byId("trustedResult");
+  box.textContent = text;
+  box.classList.toggle("error", isError);
+  box.classList.remove("hidden");
+}
+
+function syncTrustedUi() {
+  byId("trustedAttach").classList.toggle("hidden", trustedAttached);
+  byId("trustedDetach").classList.toggle("hidden", !trustedAttached);
+  byId("trustedActions").classList.toggle("hidden", !trustedAttached);
+  byId("trustedAttach").disabled = !activeTab;
+  const hasPoint = byId("x").value.trim() !== "" && byId("y").value.trim() !== "";
+  byId("trustedHover").disabled = !trustedAttached || !hasPoint;
+  byId("trustedClick").disabled = !trustedAttached || !hasPoint;
+  byId("trustedType").disabled = !trustedAttached;
+  byId("trustedDrag").disabled = !trustedAttached || !hasPoint;
+  byId("trustedScroll").disabled = !trustedAttached || !hasPoint;
+  byId("trustedStatus").textContent = trustedAttached
+    ? "مفعّل لهذا التبويب — شريط تحذير Chrome ظاهر فوق النافذة."
+    : "غير مفعّل. بعض المواقع تتجاهل النقرات الاصطناعية؛ فعّله عند الحاجة.";
+}
+
+function showResult(text, isError = false) {
+  const box = byId("clickResult");
+  box.textContent = text;
+  box.classList.toggle("error", isError);
+  box.classList.remove("hidden");
+}
+
+async function request(message) {
+  const response = await chrome.runtime.sendMessage(message);
+  if (!response?.ok) throw new Error(response?.error || "تعذر إكمال الطلب.");
+  return response.result;
+}
+
+async function refreshTab() {
+  const previousTabId = activeTab?.id;
+  byId("tabInfo").textContent = "جارٍ تحديد التبويب النشط…";
+  byId("inspect").disabled = true;
+  byId("clickAt").disabled = true;
+  try {
+    activeTab = await request({ type: "GET_ACTIVE_TAB" });
+    if (previousTabId !== null && previousTabId !== activeTab.id) {
+      latestObservation = null;
+      byId("observation").classList.add("hidden");
+    }
+    byId("tabInfo").innerHTML = "";
+    const title = document.createElement("strong");
+    title.textContent = activeTab.title || "بدون عنوان";
+    const origin = document.createElement("div");
+    origin.className = "muted";
+    origin.textContent = new URL(activeTab.url).origin;
+    byId("tabInfo").append(title, origin);
+    byId("inspect").disabled = false;
+    byId("pickPoint").disabled = false;
+    byId("grantSite").disabled = false;
+    await updateSitePermissionStatus();
+    try {
+      const status = await request({ type: "TRUSTED_STATUS", tabId: activeTab.id });
+      trustedAttached = Boolean(status.attached);
+    } catch {
+      trustedAttached = false;
+    }
+  } catch (error) {
+    activeTab = null;
+    latestObservation = null;
+    byId("observation").classList.add("hidden");
+    trustedAttached = false;
+    byId("tabInfo").textContent = error.message;
+    byId("pickPoint").disabled = true;
+    byId("grantSite").disabled = true;
+    byId("grantSite").classList.add("hidden");
+    byId("permissionStatus").textContent = "";
+  }
+  syncTrustedUi();
+}
+
+function sitePermissionPattern(urlString) {
+  const url = new URL(urlString);
+  // Chrome match patterns cannot scope host access to a port.
+  return `${url.protocol}//${url.hostname}/*`;
+}
+
+async function updateSitePermissionStatus() {
+  if (!activeTab) return;
+  const pattern = sitePermissionPattern(activeTab.url);
+  const allowed = await chrome.permissions.contains({ origins: [pattern] });
+  byId("grantSite").classList.toggle("hidden", allowed);
+  byId("permissionStatus").textContent = allowed
+    ? `السماح الدائم مفعّل لهذا الموقع (${new URL(activeTab.url).hostname})؛ يعمل على تبويباته أيضاً.`
+    : "الوصول الحالي مؤقت لهذا التبويب فقط. اسمح للموقع مرة واحدة ليعمل على تبويباته الأخرى.";
+}
+
+function selectElement(item) {
+  selectPoint(item.rect.x + item.rect.width / 2, item.rect.y + item.rect.height / 2);
+}
+
+function selectPoint(x, y) {
+  byId("x").value = String(Math.round(x));
+  byId("y").value = String(Math.round(y));
+  byId("clickAt").disabled = false;
+  byId("clickResult").classList.add("hidden");
+  syncTrustedUi();
+}
+
+function renderObservation(observation, screenshot) {
+  latestObservation = observation;
+  byId("observation").classList.remove("hidden");
+  byId("pageSummary").textContent = `${observation.title || "بدون عنوان"} · ${observation.viewport.width}×${observation.viewport.height} CSS px · ${observation.url}`;
+  byId("pageScreenshot").src = screenshot || "";
+  byId("pageScreenshot").classList.toggle("hidden", !screenshot);
+  byId("visualFallback").classList.toggle("hidden", Boolean(screenshot));
+  const markers = byId("visualMarkers");
+  markers.classList.toggle("hidden", !screenshot);
+  markers.replaceChildren();
+  for (const item of observation.elements.slice(0, 60)) {
+    const marker = document.createElement("button");
+    marker.type = "button";
+    marker.className = `visual-marker${item.disabled ? " disabled-marker" : ""}`;
+    marker.textContent = item.ref.slice(1);
+    marker.title = `${item.role}: ${item.name || "بدون اسم"}`;
+    marker.setAttribute("aria-label", marker.title);
+    marker.style.left = `${((item.rect.x + item.rect.width / 2) / observation.viewport.width) * 100}%`;
+    marker.style.top = `${((item.rect.y + item.rect.height / 2) / observation.viewport.height) * 100}%`;
+    marker.addEventListener("click", (event) => {
+      event.stopPropagation();
+      selectElement(item);
+    });
+    markers.append(marker);
+  }
+  byId("visualStage").onclick = (event) => {
+    if (event.target.closest?.(".visual-marker") || !screenshot) return;
+    const rect = byId("pageScreenshot").getBoundingClientRect();
+    if (!rect.width || !rect.height) return;
+    const x = ((event.clientX - rect.left) / rect.width) * observation.viewport.width;
+    const y = ((event.clientY - rect.top) / rect.height) * observation.viewport.height;
+    if (x < 0 || y < 0 || x >= observation.viewport.width || y >= observation.viewport.height) return;
+    selectPoint(x, y);
+    showResult(`تم اختيار النقطة x=${Math.round(x)}, y=${Math.round(y)} من الصورة. اضغط تنفيذ النقرة لتأكيدها.`);
+  };
+  byId("pageText").textContent = observation.text || "لا يوجد نص ظاهر.";
+  byId("elementCount").textContent = `${observation.elements.length} عنصر`;
+  byId("truncated").classList.toggle("hidden", !observation.truncated);
+  const list = byId("elements");
+  list.replaceChildren();
+  for (const item of observation.elements) {
+    const button = document.createElement("button");
+    button.className = "element";
+    button.disabled = item.disabled;
+    const title = document.createElement("strong");
+    title.textContent = `${item.ref} · ${item.name || "(بدون اسم)"}`;
+    const detail = document.createElement("small");
+    detail.textContent = `${item.role}${item.disabled ? " · disabled" : ""} · x:${item.rect.x} y:${item.rect.y} · ${item.rect.width}×${item.rect.height}`;
+    button.append(title, detail);
+    button.addEventListener("click", () => selectElement(item));
+    list.append(button);
+  }
+}
+
+byId("refreshTab").addEventListener("click", () => void refreshTab());
+byId("grantSite").addEventListener("click", async () => {
+  if (!activeTab) return;
+  const pattern = sitePermissionPattern(activeTab.url);
+  // Called directly in this button's click handler so Chrome can show its
+  // optional-host-permission prompt. The permission is limited to this host.
+  const permissionRequest = chrome.permissions.request({ origins: [pattern] });
+  byId("grantSite").disabled = true;
+  try {
