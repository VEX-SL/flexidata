+  // Only Input.* CDP commands are ever sent — no Network, Runtime, DOM, Page, etc.
+  const cdpMethods = [...worker.matchAll(/sendDebuggerCommand\([^,]+,\s*"([^"]+)"/g)].map((m) => m[1]);
