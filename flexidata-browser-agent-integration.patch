+function isOwnedChatImagePath(path: string, userId: string): boolean {
+  const prefix = `chat-images/${userId}/`;
+  return path.startsWith(prefix) &&
+    path.length > prefix.length &&
+    !path.split("/").some((segment) => segment === "." || segment === "..") &&
+    !path.includes("\\") &&
